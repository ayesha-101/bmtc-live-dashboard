# Copy to .env for local dev. NEVER commit the real .env.
# On Vercel these are set as Environment Variables, not in the repo.

# Neon Postgres connection string (Pooled connection recommended for
# serverless). Get it from the Neon dashboard / Vercel Storage tab.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session JWTs. Must be a long random string
# (>= 32 chars). Generate one with:  openssl rand -base64 48
# Never reuse this example value.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional: the first Admin account the seed script creates. The Admin then
# creates the Manager (BM) and all employees from inside the app.
SEED_ADMIN_EMAIL="admin@bmtc.local"
SEED_ADMIN_NAME="System Admin"

# --- Email (optional) -------------------------------------------------
# When configured, new accounts and password resets are emailed their
# sign-in details automatically. Leave everything below unset and the app
# simply shows the one-time password on screen instead.
#
# Option A — SMTP. Works straight away with an account you already own and
# needs no DNS changes. For Gmail: turn on 2-Step Verification, then create
# an App Password (Google Account -> Security -> App passwords) and paste
# the 16 characters as SMTP_PASS.
SMTP_USER=""
SMTP_PASS=""
# Defaults suit Gmail; override for another provider.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"

# Option B — Resend. Better for volume, but needs a verified sending
# domain. Takes precedence over SMTP when both are set.
# RESEND_API_KEY=""

# The From address. Optional for SMTP (defaults to SMTP_USER); required
# for Resend, where it must be on your verified domain.
# MAIL_FROM="BMTC <no-reply@bmtc.ae>"

# Only needed if the auto-detected site URL is wrong (e.g. behind a proxy).
# APP_URL="https://bmtc-live-dashboard.vercel.app"
