// BMTC Live Dashboard — data model.
//
// One row per ENQUIRY, carried through its whole commercial life:
//   enquiry → quotation → LPO → invoice   (or → lost)
// Each stage keeps its OWN reference, value, GP and date, because they
// genuinely differ: a quote of 500k can be awarded at 480k and invoiced
// at 475k. Reporting therefore distinguishes pipeline (quoted), booked
// (LPO) and recognised revenue (invoiced).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The four producing business units plus the Sales Admin function. Sales
// Admin is modelled as a "department": a Sales Admin is an employee whose
// department is sales_admin, and that alone grants the invoicing queue.
enum Department {
  electrical
  urban
  lightning
  water
  // Retail counter. Showrooms do not quote or invoice through this system
  // — they record the customer's LPO and the sale is done — so their rows
  // go straight to the `sold` stage.
  showroom
  sales_admin
}

// Three roles with deliberately separate jobs:
//   employee — works enquiries (or, in sales_admin, invoices them)
//   manager  — the BM: read-only dashboard, activity, and targets
//   admin    — accounts + security only; never sees business data
enum UserRole {
  employee
  manager
  admin
}

// Where an enquiry has reached. Stages move forward only.
enum DealStage {
  enquiry // logged by Estimation, not yet quoted
  quoted // quotation issued — pipeline
  lpo_received // customer awarded — booked
  pending_invoice // ready to bill, waiting on Sales Admin
  invoiced // billed — recognised revenue
  sold // Showroom: LPO taken, sale complete, no invoicing step
  lost // did not close
}

model User {
  id                 Int        @id @default(autoincrement())
  email              String     @unique
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  department         Department
  role               UserRole   @default(employee)
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  isActive           Boolean    @default(true) @map("is_active")
  failedAttempts     Int        @default(0) @map("failed_attempts")
  lockedUntil        DateTime?  @map("locked_until")
  createdById        Int?       @map("created_by")
  createdBy          User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]     @relation("UserCreatedBy")
  createdAt          DateTime   @default(now()) @map("created_at")

  dealsCreated  Deal[]     @relation("DealCreatedBy")
  dealsInvoiced Deal[]     @relation("DealInvoicedBy")
  auditEntries  AuditLog[]

  @@map("users")
}

model Deal {
  id          Int        @id @default(autoincrement())
  // Internal tracking number, generated by the system.
  reference   String     @unique
  department  Department
  createdById Int        @map("created_by")
  createdBy   User       @relation("DealCreatedBy", fields: [createdById], references: [id])

  // ---- Enquiry (the Estimation sheet's own columns) ----
  enquiryDate   DateTime @map("enquiry_date")
  customer      String
  projectName   String   @map("project_name")
  salesPerson   String   @default("") @map("sales_person")
  deResponsible String   @default("") @map("de_responsible")
  // The brand(s) quoted on this enquiry — free text, since a job can span
  // several and the list changes with supplier agreements.
  brand         String   @default("")

  // ---- Quotation ----
  quoteRef   String?   @map("quote_ref")
  quoteValue Decimal?  @map("quote_value") @db.Decimal(14, 2)
  quoteGp    Decimal?  @map("quote_gp") @db.Decimal(14, 2)
  quoteDate  DateTime? @map("quote_date")

  // ---- LPO (customer award) ----
  lpoRef   String?   @map("lpo_ref")
  lpoValue Decimal?  @map("lpo_value") @db.Decimal(14, 2)
  lpoGp    Decimal?  @map("lpo_gp") @db.Decimal(14, 2)
  lpoDate  DateTime? @map("lpo_date")

  // ---- Invoice (recognised revenue) ----
  invoiceRef   String?   @map("invoice_ref")
  invoiceValue Decimal?  @map("invoice_value") @db.Decimal(14, 2)
  invoiceGp    Decimal?  @map("invoice_gp") @db.Decimal(14, 2)
  invoiceDate  DateTime? @map("invoice_date")
  invoicedById Int?      @map("invoiced_by")
  invoicedBy   User?     @relation("DealInvoicedBy", fields: [invoicedById], references: [id])

  stage      DealStage @default(enquiry)
  lostReason String?   @map("lost_reason")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  auditEntries AuditLog[]

  @@index([stage])
  @@index([createdById])
  @@index([invoiceDate])
  @@index([lpoDate])
  @@map("deals")
}

// Annual revenue and GP target per department, set by the BM. The monthly
// view compares against target/12; the yearly view against the full
// figure.
model Target {
  id            Int        @id @default(autoincrement())
  department    Department
  year          Int
  revenueTarget Decimal    @map("revenue_target") @db.Decimal(14, 2)
  gpTarget      Decimal    @map("gp_target") @db.Decimal(14, 2)
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@unique([department, year])
  @@map("targets")
}

// Append-only, hash-chained audit trail. The application DB role should
// NOT hold DELETE or UPDATE here, so the log cannot be rewritten even by
// a bug. Every write happens in the same transaction as the change.
model AuditLog {
  id         Int        @id @default(autoincrement())
  dealId     Int        @map("deal_id")
  deal       Deal       @relation(fields: [dealId], references: [id])
  actorId    Int        @map("actor_id")
  actor      User       @relation(fields: [actorId], references: [id])
  department Department
  action     String
  note       String?
  createdAt  DateTime   @default(now()) @map("created_at")
  prevHash   String     @default("") @map("prev_hash")
  hash       String     @default("") @map("hash")

  @@index([createdAt])
  @@index([dealId])
  @@map("audit_log")
}

// Backs the internal reference (BMTC-JIH-YYYYMM-<value>).
model Counter {
  id    String @id
  value Int    @default(1396)

  @@map("counters")
}
